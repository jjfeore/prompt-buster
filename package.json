{
  "name": "prompt-buster",
  "version": "0.1.0",
  "description": "Local prompt-injection firewall for AI agents that browse the web: layered pre-filters (regex, LightGBM, Wolf Defender), optional LLM review, and human/agent escalation — for Claude Code, Codex, OpenClaw, Hermes, and OpenCode",
  "type": "module",
  "bin": { "prompt-buster": "./bin/prompt-buster.mjs" },
  "files": [
    "bin/",
    "lib/",
    "hooks/",
    "scripts/pb-hook.mjs",
    "scripts/generate-manifests.mjs",
    "integrations/",
    "skills/",
    ".claude-plugin/",
    "models/",
    "docs/"
  ],
  "engines": { "node": ">=18" },
  "exports": {
    ".": "./lib/engine/pipeline.js",
    "./opencode": "./integrations/opencode/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate-manifests": "node scripts/generate-manifests.mjs",
    "version": "node scripts/generate-manifests.mjs && git add .claude-plugin",
    "test": "node --test test/"
  },
  "author": { "name": "James Feore" },
  "repository": { "type": "git", "url": "git+https://github.com/jjfeore/prompt-buster.git" },
  "homepage": "https://github.com/jjfeore/prompt-buster#readme",
  "license": "MIT",
  "keywords": [
    "prompt-injection",
    "security",
    "agent",
    "firewall",
    "claude-code",
    "codex",
    "openclaw",
    "hermes",
    "opencode",
    "mcp",
    "agentskills",
    "llm-security"
  ]
}
